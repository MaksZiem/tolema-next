# Wysyłka formularza kontaktowego (src/app/contact/actions.ts) przez Resend.
# 1. Załóż darmowe konto na https://resend.com (100 maili/dzień, 3000/mies. za darmo).
# 2. Wygeneruj klucz API i wklej go poniżej.
# 3. Bez weryfikacji własnej domeny w Resend można wysyłać wyłącznie na adres e-mail,
#    którym założono konto Resend — wystarczające dla prostego formularza kontaktowego.
#    Aby wysyłać z własnej domeny (np. kontakt@tolema.pl), zweryfikuj domenę w Resend
#    i ustaw CONTACT_FROM_EMAIL poniżej.
#
# WAŻNE: ten plik (.env.example) jest commitowany do gita jako dokumentacja —
# realny klucz wklejaj tylko do .env.local (jest w .gitignore, nigdy nie trafi do repo).
RESEND_API_KEY=

# Adres, na który trafiają wiadomości z formularza (domyślnie operat23@gmail.com).
CONTACT_TO_EMAIL=operat23@gmail.com

# Adres nadawcy widoczny w skrzynce odbiorczej (domyślnie sandbox Resend).
CONTACT_FROM_EMAIL="Formularz kontaktowy TOLEMA <onboarding@resend.dev>"

# Google Analytics 4 (np. G-XXXXXXXXXX). Bez tej zmiennej GA i baner cookies są wyłączone.
# GA ładuje się dopiero po kliknięciu „Akceptuję” w banerze (src/components/consent/CookieConsent.tsx).
NEXT_PUBLIC_GA_ID=
