# Wysyłka formularza kontaktowego (src/app/contact/actions.ts) przez SMTP poczty home.pl.
# Dane serwera: panel home.pl → Poczta → wybrana skrzynka → „Konfiguracja programu pocztowego”
# (serwer ma postać np. serwerXXXXXX.home.pl). Port 465 = SSL, 587 = STARTTLS.
#
# WAŻNE: ten plik (.env.example) jest commitowany do gita jako dokumentacja —
# realne hasło wklejaj tylko do .env.local (jest w .gitignore, nigdy nie trafi do repo)
# oraz do zmiennych środowiskowych na serwerze produkcyjnym.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=info@tolema.pl
SMTP_PASSWORD=

# Adres, na który trafiają wiadomości z formularza (domyślnie info@tolema.pl).
CONTACT_TO_EMAIL=info@tolema.pl

# Opcjonalnie: nadawca widoczny w skrzynce. Adres musi być tą samą skrzynką co SMTP_USER,
# inaczej home.pl odrzuci wiadomość. Domyślnie: "Formularz kontaktowy TOLEMA <SMTP_USER>".
# CONTACT_FROM_EMAIL="Formularz kontaktowy TOLEMA <info@tolema.pl>"

# Google Analytics 4 (np. G-XXXXXXXXXX). Bez tej zmiennej GA i baner cookies są wyłączone.
# GA ładuje się dopiero po kliknięciu „Akceptuję” w banerze (src/components/consent/CookieConsent.tsx).
NEXT_PUBLIC_GA_ID=
